map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 127.0.0.1:8080;
    listen 127.0.0.1:8443 ssl;
    listen 443 ssl default_server;
    http2 on;
    server_name __HOST_IP__;

    ssl_certificate     /etc/nginx/certs/matrix.crt;
    ssl_certificate_key /etc/nginx/certs/matrix.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50M;

    location = /.well-known/matrix/client {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers * always;
        add_header Content-Type application/json always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        if ($request_method = OPTIONS) { return 204; }
        return 200 '{"m.homeserver":{"base_url":"https://__SERVER_NAME__"},"org.matrix.msc4143.rtc_foci":[{"type":"livekit","livekit_service_url":"https://__SERVER_NAME__/livekit/jwt"}],"org.matrix.msc3401.call1to1":{"enabled":true}}';
    }

    location = /.well-known/matrix/server {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        add_header Content-Type application/json always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 '{"m.server":"__SERVER_NAME__"}';
    }

    location = /.well-known/element/element.json {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        add_header Content-Type application/json always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        if ($request_method = OPTIONS) { return 204; }
        return 200 '{"element_call":{"url":"https://call.element.io","use_exclusively":false},"livekit":{"livekit_service_url":"https://__SERVER_NAME__/livekit/jwt"}}';
    }

    location ^~ /_matrix/client/unstable/org.matrix.msc4143/rtc/transports {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        add_header Content-Type application/json always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        if ($request_method = OPTIONS) { return 204; }
        return 200 '{"rtc_transports":[{"type":"livekit","livekit_service_url":"https://__SERVER_NAME__/livekit/jwt"}]}';
    }

    location ^~ /_matrix/client/v1/rtc/transports {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        add_header Content-Type application/json always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        if ($request_method = OPTIONS) { return 204; }
        return 200 '{"rtc_transports":[{"type":"livekit","livekit_service_url":"https://__SERVER_NAME__/livekit/jwt"}]}';
    }

    location = /livekit/jwt {
        return 308 /livekit/jwt/;
    }

    location ^~ /livekit/jwt/ {
        proxy_pass http://lk-jwt:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Methods;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        if ($request_method = OPTIONS) { return 204; }
    }

    location ^~ /livekit/sfu/ {
        proxy_pass http://livekit:7880/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /sfu/ {
        proxy_pass http://lk-jwt:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Methods;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        if ($request_method = OPTIONS) { return 204; }
    }

    location = /trust {
        return 308 /trust/;
    }

    location = /trust/ {
        root /etc/nginx/certs;
        try_files /trust-index.html =404;
        default_type text/html;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /trust/neura-matrix-ca.crt {
        alias /etc/nginx/certs/neura-matrix-ca.crt;
        default_type application/x-x509-ca-cert;
        add_header Access-Control-Allow-Origin * always;
        add_header Content-Disposition "attachment; filename=neura-matrix-ca.crt" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /trust/install-matrix-ca.ps1 {
        alias /etc/nginx/certs/install-matrix-ca.ps1;
        default_type text/plain;
        add_header Access-Control-Allow-Origin * always;
        add_header Content-Disposition "attachment; filename=install-matrix-ca.ps1" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /trust/install-matrix-ca.cmd {
        alias /etc/nginx/certs/install-matrix-ca.cmd;
        default_type application/octet-stream;
        add_header Access-Control-Allow-Origin * always;
        add_header Content-Disposition "attachment; filename=install-matrix-ca.cmd" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /trust/neura-matrix-trust.mobileconfig {
        alias /etc/nginx/certs/neura-matrix-trust.mobileconfig;
        default_type application/x-apple-aspen-config;
        add_header Access-Control-Allow-Origin * always;
        add_header Content-Disposition "attachment; filename=neura-matrix-trust.mobileconfig" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /healthz {
        proxy_pass http://lk-jwt:8080/healthz;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://conduit:6167;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        client_max_body_size 50M;
    }
}

