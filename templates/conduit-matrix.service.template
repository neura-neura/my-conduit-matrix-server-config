[Unit]
Description=Conduit Matrix homeserver with MatrixRTC (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
TimeoutStartSec=600
TimeoutStopSec=120
Restart=on-failure
RestartSec=15
ExecStartPre=__INSTALL_DIR__/wait-for-ip.sh
ExecStartPre=__INSTALL_DIR__/render-config.sh __DATA_DIR__
ExecStart=__DOCKER_BIN__ compose --env-file __INSTALL_DIR__/.env -f __INSTALL_DIR__/compose.yaml up -d --remove-orphans
ExecStop=__DOCKER_BIN__ compose --env-file __INSTALL_DIR__/.env -f __INSTALL_DIR__/compose.yaml stop

[Install]
WantedBy=multi-user.target
