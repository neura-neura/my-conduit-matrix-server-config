# Copy this file to .env and edit it before running ./install.sh.
# Do not commit .env.

# systemd service name and install location.
SERVICE_NAME=conduit-matrix
INSTALL_DIR=/opt/conduit-matrix
COMPOSE_PROJECT_NAME=conduit-matrix

# Public Matrix server name. For a ZeroTier or LAN install this is usually
# HOST_IP:MATRIX_PORT, for example 192.168.196.65:6167.
# Changing SERVER_NAME later creates a different homeserver identity.
SERVER_NAME=192.168.196.65:6167

# Host/VPN address that clients will use. This is usually a ZeroTier IP.
HOST_IP=192.168.196.65

# Public Matrix HTTPS/HTTP port. Nginx listens here and multiplexes TLS.
MATRIX_PORT=6167

# Optional federation TLS port published on HOST_IP.
FEDERATION_PORT=8448

# Optional Cinny web client published on HOST_IP.
CINNY_PORT=6168

# LiveKit media ports published on HOST_IP.
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# Shared LiveKit key/secret. Change these before exposing the server beyond
# a private ZeroTier network.
LIVEKIT_KEY=devkey
LIVEKIT_SECRET=secretsecretsecretsecretsecretsecret

# Optional TURN values advertised by Conduit. Leave empty if you do not run TURN.
TURN_SECRET=
TURN_TTL=86400

# Persistent data directory on the host.
DATA_DIR=/var/lib/conduit-matrix

# Docker images.
CONDUIT_IMAGE=matrixconduit/matrix-conduit:latest
LIVEKIT_IMAGE=livekit/livekit-server:latest
LK_JWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:latest
NGINX_IMAGE=nginx:alpine
CINNY_IMAGE=ghcr.io/cinnyapp/cinny:latest

# Container names.
CONDUIT_CONTAINER=conduit
LIVEKIT_CONTAINER=livekit-server
LK_JWT_CONTAINER=lk-jwt-service
PROXY_CONTAINER=conduit-proxy
CINNY_CONTAINER=cinny-web

# Self-signed certificate subject. The generated cert always includes HOST_IP.
CERT_DAYS=3650
CERT_SUBJECT=/CN=192.168.196.65

# Startup wait settings. The service waits for HOST_IP before docker compose up.
WAIT_TIMEOUT_SECONDS=300
WAIT_INTERVAL_SECONDS=2
